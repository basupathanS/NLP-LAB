import matplotlib.pyplot as plt
from sklearn.decomposition import LatentDirichletAllocation
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.manifold import TSNE


# Get customer reviews
reviews = []

n = int(input("Enter number of reviews: "))

for i in range(n):
    review = input(f"Enter review {i + 1}: ")
    reviews.append(review)


# Convert reviews into Bag-of-Words vectors
vectorizer = CountVectorizer(stop_words="english")
X = vectorizer.fit_transform(reviews)


# Train LDA model
lda = LatentDirichletAllocation(
    n_components=2,
    random_state=42
)

lda.fit(X)


# Display topics
words = vectorizer.get_feature_names_out()

print("\nTopics:")

for i, topic in enumerate(lda.components_):
    print(f"\nTopic {i + 1}")

    top_words = topic.argsort()[-5:]

    for index in reversed(top_words):
        print(words[index])


# Convert sparse matrix to dense
X_dense = X.toarray()


# t-SNE visualization
if len(reviews) >= 2:
    perplexity = min(2, len(reviews) - 1)

    tsne = TSNE(
        n_components=2,
        random_state=42,
        perplexity=perplexity
    )

    X_tsne = tsne.fit_transform(X_dense)

    print("\nt-SNE Coordinates:")

    for i, point in enumerate(X_tsne):
        print(f"Review {i + 1}: {point}")

    plt.figure(figsize=(8, 6))
    plt.scatter(X_tsne[:, 0], X_tsne[:, 1])

    for i in range(len(reviews)):
        plt.text(
            X_tsne[i, 0],
            X_tsne[i, 1],
            f"R{i + 1}"
        )

    plt.title("t-SNE Visualization of Customer Reviews")
    plt.xlabel("Dimension 1")
    plt.ylabel("Dimension 2")
    plt.show()

else:
    print("\nAt least two reviews are required for t-SNE visualization.")