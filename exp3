import nltk
from nltk.corpus import wordnet as wn
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
from sklearn.cluster import KMeans


# Download required NLTK resources
nltk.download("wordnet")
nltk.download("omw-1.4")


# Get headlines from user
headlines = []

n = int(input("Enter number of headlines: "))

for i in range(n):
    headline = input(f"Enter headline {i + 1}: ")
    headlines.append(headline)


# Convert headlines into TF-IDF vectors
vectorizer = TfidfVectorizer()
X = vectorizer.fit_transform(headlines)


# Calculate cosine similarity
print("\nCosine Similarity Matrix:")
print(cosine_similarity(X))


# Group headlines using K-Means
kmeans = KMeans(
    n_clusters=2,
    random_state=0,
    n_init=10
)

kmeans.fit(X)


# Display headline clusters
print("\nHeadline Clusters:")

for i in range(len(headlines)):
    print(
        headlines[i],
        "-> Cluster",
        kmeans.labels_[i]
    )


# Get two words from user
w1 = input("\nEnter first word: ")
w2 = input("Enter second word: ")


# Find WordNet synsets
s1 = wn.synsets(w1)
s2 = wn.synsets(w2)


# Calculate WordNet similarity
if s1 and s2:
    similarity = s1[0].path_similarity(s2[0])
    print("\nWordNet Similarity:", similarity)
else:
    print("\nSimilarity not found.")